# URL адаптера, который LibreChat получает в /files/{id}/url.
SELF_BASE_URL=http://ocr-shim:8000

# Должен совпадать с ocr.apiKey LibreChat.
OCR_SHARED_SECRET=

# Обязательные настройки MDdoc. Ключ определяет источник и его приоритет.
MDDOC_URL=http://mddoc:8000
MDDOC_API_KEY=

# Пусто — движок выбирает MDdoc (обычно auto).
# Переопределение: auto, model, text; прежние алиасы проверяет MDdoc.
MDDOC_ENGINE=

# Режим иллюстраций Tagged PDF: true — с описанием, false — без описания.
# Передаётся в MDdoc для каждого документа; конфиг MDdoc не меняется.
# Поле describe_pdf_figures в POST /files переопределяет это значение.
MDDOC_DESCRIBE_PDF_FIGURES=true

# Ожидание результата в /ocr или открытом SSE-потоке, секунды.
MDDOC_TIMEOUT=1800
MDDOC_POLL_INTERVAL=5
MDDOC_HTTP_TIMEOUT=30

# У MDdoc есть собственный лимит размера.
MAX_UPLOAD_BYTES=62914560

# CA bundle для HTTPS к MDdoc; пусто — системное хранилище.
CA_CERT=
LOG_LEVEL=INFO
