# -----------------------------------------------------------------------------
# Базовые настройки сервиса
# -----------------------------------------------------------------------------

# Уровень логирования Python/FastAPI: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Внутренний URL самого OCR-шима, который возвращается LibreChat как signed URL.
# В docker-compose обычно должен совпадать с именем сервиса в сети LibreChat.
SELF_BASE_URL=http://ocr-shim:8000

# Общий секрет для доступа к OCR-шиму.
# Должен совпадать с apiKey в блоке ocr librechat.yaml.
OCR_SHARED_SECRET=

# Путь к CA bundle для TLS-подключения к LLM-шлюзу.
# Оставьте пустым, если системных сертификатов достаточно.
CA_CERT=/app/ca.crt


# -----------------------------------------------------------------------------
# LLM OCR через vision-модель
# -----------------------------------------------------------------------------

# URL OpenAI-совместимого endpoint для chat completions.
# Обязателен для OCR_ENGINE=llm и для режима сравнения OCR.
LLM_CHAT_URL=https://llmproxy.rnd-ai.rn-t.ru/v1/chat/completions

# API-ключ к LLM-шлюзу. Если шлюз не требует ключ, можно оставить пустым.
LLM_API_KEY=

# Алиас vision-модели в LLM-шлюзе, которая распознает изображения.
VISION_MODEL=qwen-3.6-thinking

# Таймаут одного запроса к LLM OCR, в секундах.
LLM_TIMEOUT=180

# Максимальное число токенов в ответе vision-модели на одну страницу.
OCR_MAX_TOKENS=4096

# Промпт для LLM OCR. Можно переопределить под нужный формат извлечения текста.
OCR_PROMPT=Извлеки весь текст с этого изображения документа дословно, сохраняя порядок строк, таблицы (в виде markdown-таблиц) и структуру. Не добавляй комментариев, пояснений или заголовков — только сам распознанный текст в формате markdown. Если на изображении нет текста, верни пустую строку.


# -----------------------------------------------------------------------------
# Выбор OCR-движка
# -----------------------------------------------------------------------------

# Основной OCR-движок, текст которого будет возвращен LibreChat.
# Возможные значения: llm, tesseract.
OCR_ENGINE=llm

# DPI для рендеринга PDF/Office-страниц в PNG перед OCR.
# 200 обычно быстрее, 300 лучше для мелкого текста.
OCR_DPI=200

# Сколько документов можно обрабатывать одновременно.
DOCUMENT_CONCURRENCY=1

# Сколько страниц одного документа можно обрабатывать параллельно.
CONCURRENCY=4


# -----------------------------------------------------------------------------
# Экспериментальный Tesseract OCR
# -----------------------------------------------------------------------------

# Включает возможность использовать Tesseract.
# Требуется для OCR_ENGINE=tesseract и для ENABLE_OCR_COMPARISON=true.
# Держите false, если Tesseract и сравнение OCR не нужны.
ENABLE_TESSERACT_OCR=false

# Языки Tesseract: русский, английский, китайский упрощенный.
# Для китайского традиционного используйте chi_tra, если установлен языковой пакет.
TESSERACT_LANGS=rus+eng+chi_sim

# Таймаут обработки одной страницы через Tesseract, в секундах.
TESSERACT_TIMEOUT=120


# -----------------------------------------------------------------------------
# Экспериментальное сравнение LLM OCR и Tesseract
# -----------------------------------------------------------------------------

# Если true, каждая страница распознается обоими движками,
# а затем два результата отправляются в LLM-судью для сравнения качества.
# Требует ENABLE_TESSERACT_OCR=true.
ENABLE_OCR_COMPARISON=false

# Алиас модели-судьи в LLM-шлюзе.
# Обязателен при ENABLE_OCR_COMPARISON=true.
OCR_COMPARISON_MODEL=

# Таймаут запроса к модели-судье, в секундах.
OCR_COMPARISON_TIMEOUT=120

# Максимальная длина каждого OCR-текста одной страницы,
# который отправляется модели-судье на сравнение.
MAX_OCR_COMPARISON_TEXT_CHARS=20000


# -----------------------------------------------------------------------------
# Экспериментальный OCR Office-документов
# -----------------------------------------------------------------------------

# Включает OCR для .doc/.docx/.ppt/.pptx/.odt/.ott/.odp/.otp через LibreOffice -> PDF.
ENABLE_OFFICE_OCR=false

# Таймаут конвертации Office-документа в PDF через LibreOffice, в секундах.
OFFICE_CONVERT_TIMEOUT=120

# Если в .docx/.pptx/ODF найдено не меньше этого числа символов без пробелов,
# OCR пропускается, а извлеченный встроенный текст возвращается напрямую.
OFFICE_OCR_TEXT_THRESHOLD=50

# Максимальная длина text-only ответа, извлеченного из Office-файла без OCR.
MAX_EXTRACTED_TEXT_CHARS=300000


# -----------------------------------------------------------------------------
# Лимиты защиты
# -----------------------------------------------------------------------------

# Максимальный размер загружаемого файла, в байтах. 62914560 = 60 MB.
MAX_UPLOAD_BYTES=62914560

# Максимальное число страниц, которое разрешено отрендерить из PDF/Office.
MAX_RENDERED_PAGES=80

# Максимальное число страниц, которое разрешено отправить в OCR-движок.
MAX_OCR_PAGES=60
